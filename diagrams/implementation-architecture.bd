    {
      "id": "node_protocol_spec",
      "type": "rectangle",
      "x": 60,
      "y": 300,
      "width": 580,
      "height": 130,
      "strokeColor": "#f59e0b",
      "fillColor": "#f59e0b1a",
      "strokeWidth": 2,
      "roughness": 0,
      "seed": 504,
      "zIndex": 4,
      "text": "BINARY STREAMING PROTOCOL SPECIFICATION (16-Byte Header + PCM16 Payload)\n[0..4] Magic: 'LAUD' (0x4C415544) | [4..5] Version: 1 | [5..6] Flags: 0x01 (Normal), 0x02 (Silence)\n[6..7] Channels: 2 | [7..8] Format: 0x10 (PCM16 LE 48kHz)\n[8..12] Sequence: u32 (Big-Endian monotonically increasing)\n[12..16] Timestamp: u32 (Sample clock anchor at 48 kHz)\n[16..N] Interleaved 16-bit PCM Audio Payload (L, R, L, R, ...)",
      "fontSize": 12,
      "fontFamily": "Inter, sans-serif",
      "textAlign": "center",
      "verticalAlign": "middle"
    },
